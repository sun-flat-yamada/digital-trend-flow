# ==========================================
# Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# GitHub Actions: Register these as Repository Secrets
# at Settings > Secrets and variables > Actions

# ── Required ───────────────────────────────
# Gemini API Key (https://ai.google.dev/)
GEMINI_API_KEY="dummy_key_for_testing"

# ── Optional: Ingestion Sources ────────────
# Raindrop.io Test Token (https://app.raindrop.io/settings/integrations)
RAINDROP_TEST_TOKEN=""

# xAI API Key — for X/Twitter search via Grok (https://console.x.ai/)
XAI_API_KEY=""

# ── Optional: Publishing & Notifications ───
# note.com API Token
NOTE_API_TOKEN=""

# Discord Webhook URL (https://discord.com/developers/docs/resources/webhook)
DISCORD_WEBHOOK_URL=""

# ── GitHub Actions specific ─────────────────
# Personal Access Token with `repo` scope — needed for git push in Actions
# (generate at GitHub Settings > Developer settings > PATs)
# PAT_GITHUB=""   ← Register this as a Repository Secret, NOT in .env
