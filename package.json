{
  "name": "digital-trend-flow",
  "version": "0.0.1",
  "description": "An automated pipeline to Harvest daily digital trends, process them via LLMs, and output highly structural summaries.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:config": "ts-node src/cli/test_config.ts",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:golden": "jest tests/golden_regression",
    "test": "npm run type-check && npm run test:config && npm run test:unit",
    "type-check": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "build": "tsc",
    "build:pages": "ts-node src/cli/build_pages.ts",
    "report": "ts-node src/cli/report.ts",
    "report:weekly": "ts-node src/cli/report.ts weekly",
    "report:monthly": "ts-node src/cli/report.ts monthly",
    "report:yearly": "ts-node src/cli/report.ts yearly",
    "start": "node dist/cli/daily.js",
    "debug:filter": "ts-node src/cli/dry_run.ts",
    "check:sources": "ts-node src/cli/check_sources.ts",
    "change-dev:branch": "ts-node src/cli/change_dev_branch.ts",
    "change-dev:plan-check": "ts-node src/cli/plan_check.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint . --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "types": [
              "node",
              "jest"
            ],
            "strict": true,
            "esModuleInterop": true
          }
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "coverageReporters": [
      "text-summary"
    ],
    "coverageThreshold": {
      "./src/main.ts": {
        "lines": 70
      },
      "./src/cli/daily.ts": {
        "lines": 70
      },
      "./src/ingestion/state_manager.ts": {
        "lines": 70
      },
      "./src/summarization/llm_gateway.ts": {
        "lines": 70
      },
      "./src/summarization/gemini_map.ts": {
        "lines": 70
      },
      "./src/summarization/gemini_reduce.ts": {
        "lines": 70
      },
      "./src/ingestion/{arxiv,bluesky,fetch_source,github_trending,hackernews,jina_reader,raindrop,reddit,rss,youtube}.ts": {
        "lines": 70
      }
    }
  },
  "keywords": [],
  "author": "Youhei Yamada",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-yml": "^3.8.1",
    "jest": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "prettier": "3.9.9",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.0",
    "yaml-eslint-parser": "^2.1.0"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.7",
    "langfuse": "^3.39.2",
    "markdown-it": "15.0.2",
    "nodemailer": "^10.0.10",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "markdown-it": {
      "argparse": "3.0.2"
    }
  }
}
