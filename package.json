{
  "name": "digital-trend-flow",
  "version": "0.0.1",
  "description": "An automated pipeline to Harvest daily digital trends, process them via LLMs, and output highly structural summaries.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:config": "ts-node src/cli/test_config.ts",
    "test:unit": "jest --forceExit",
    "test:golden": "jest tests/golden_regression --forceExit",
    "test": "npm run type-check && npm run test:config && npm run test:unit",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "build:pages": "ts-node src/cli/build_pages.ts",
    "start": "node dist/main.js",
    "debug:filter": "ts-node src/cli/dry_run.ts",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "tsconfig": { "module": "commonjs", "moduleResolution": "node", "types": ["node", "jest"], "strict": true, "esModuleInterop": true } }]
    },
    "transformIgnorePatterns": ["/node_modules/(?!uuid)"],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "testMatch": ["**/tests/**/*.test.ts"]
  },
  "keywords": [],
  "author": "Youhei Yamada",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-yml": "^3.8.1",
    "jest": "^30.5.1",
    "jsonc-eslint-parser": "^3.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "yaml-eslint-parser": "^2.1.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "langfuse": "^3.38.20",
    "p-retry": "^8.0.1",
    "rss-parser": "^3.13.0",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
